{
  "name": "qr-to-link-monorepo",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Professional Production-Ready Monorepo for QR TO LINK (Website + Mobile App + Backend + Admin + Shared Packages)",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "vite",
    "dev:turbo": "npx turbo run dev",
    "dev:web": "vite",
    "dev:mobile": "npm run dev --prefix apps/mobile",
    "dev:backend": "npm run dev --prefix backend",
    "server": "tsx server.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "vite"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
